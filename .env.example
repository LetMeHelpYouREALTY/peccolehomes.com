# Google Search Console: paste the content value from GSC verification (HTML tag method).
# After adding, redeploy so the meta tag is present on the live site.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: RealScout agent ID (base64). Overrides lib/site.ts default if set.
# NEXT_PUBLIC_REALSCOUT_AGENT_ID=

# Google Maps JavaScript API + Places (New) for the interactive amenity map.
# Without this key, the site shows an embed fallback and static amenity list.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: Map ID for Advanced Markers styling (works without it).
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
